### 2. Update [patient-results-new.html](file:///c:/Users/PMLS/Desktop/ui%20ph1/patient-results-new.html)

**Location:** Lines 256-361 (replace the entire `<script>` section)

**Replace the entire script section** with:

```javascript
document.addEventListener('DOMContentLoaded', function () {
    // Retrieve patient data
    const patientData = JSON.parse(sessionStorage.getItem('currentPatient') || '{}');
    const uploadedImage = sessionStorage.getItem('uploadedImage');
    
    // Retrieve REAL prediction data from backend
    const predictedClass = sessionStorage.getItem('predictedClass');
    const confidence = sessionStorage.getItem('confidence');
    const probabilities = sessionStorage.getItem('probabilities');

    // Check if we have prediction data
    if (!predictedClass || !confidence || !uploadedImage) {
        showAlert('No prediction data found. Please upload and analyze a scan first.', 'warning');
        setTimeout(() => {
            window.location.href = 'patient-upload.html';
        }, 2000);
        return;
    }

    // Display patient information (if available)
    if (patientData.name) {
        document.getElementById('patientName').textContent = patientData.name;
        document.getElementById('patientId').textContent = patientData.patientId || 'N/A';
        document.getElementById('patientAge').textContent = (patientData.age ? patientData.age + ' years' : 'N/A');
        document.getElementById('patientGender').textContent = patientData.gender || 'N/A';
    } else {
        // Use placeholder if no patient data
        document.getElementById('patientName').textContent = 'Patient';
        document.getElementById('patientId').textContent = 'N/A';
        document.getElementById('patientAge').textContent = 'N/A';
        document.getElementById('patientGender').textContent = 'N/A';
    }

    // Display original scan
    document.getElementById('originalScan').src = uploadedImage;

    // Generate scan ID
    const scanId = 'SCAN-2025-' + Math.floor(Math.random() * 9000 + 1000);
    document.getElementById('scanId').textContent = scanId;

    // Display current date and time
    const now = new Date();
    const dateOptions = { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' };
    document.getElementById('analysisDate').textContent = now.toLocaleDateString('en-US', dateOptions);

    // Display REAL confidence from backend
    document.getElementById('confidence').textContent = confidence + '%';

    // Display result based on REAL prediction
    displayResult(predictedClass, confidence, probabilities);
});

function displayResult(predictedClass, confidence, probabilitiesJson) {
    const resultCard = document.getElementById('resultStatusCard');
    const recommendationBox = document.getElementById('recommendationBox');
    
    // Parse probabilities
    let probabilities = {};
    try {
        probabilities = JSON.parse(probabilitiesJson || '{}');
    } catch (e) {
        console.error('Error parsing probabilities:', e);
    }

    // Determine if tumor detected based on predicted class
    const tumorDetected = predictedClass !== 'notumor';
    
    // Map class names to display names
    const classDisplayNames = {
        'glioma': 'Glioma Tumor',
        'meningioma': 'Meningioma Tumor',
        'pituitary': 'Pituitary Tumor',
        'notumor': 'No Tumor'
    };
    
    const displayName = classDisplayNames[predictedClass] || predictedClass;

    if (tumorDetected) {
        // Tumor detected result
        resultCard.innerHTML = `
            <div class="card-body p-4" style="background: linear-gradient(135deg, #EED987 0%, #8A6E45 100%); 
box-shadow: 0 8px 24px rgba(238, 217, 135, 0.3), 0 0 30px rgba(138, 110, 69, 0.2); 
border: 1px solid rgba(138, 110, 69, 0.5);">
                <div class="text-white text-center">
                    <i class="bi bi-exclamation-triangle-fill animate-scaleIn" style="font-size: 4rem; opacity: 0.9; animation-delay: 0.3s;"></i>
                    <h2 class="fw-bold mt-3 mb-2 animate-fadeInUp" style="animation-delay: 0.5s;">Tumor Detected: ${displayName}</h2>
                    <p class="mb-0 fs-5 animate-fadeInUp" style="animation-delay: 0.7s;">Our AI system has identified a potential ${displayName.toLowerCase()}</p>
                    <p class="mb-0 mt-2 opacity-75 animate-fadeInUp" style="animation-delay: 0.9s;">Model Confidence: ${confidence}%</p>
                </div>
            </div>
        `;

        recommendationBox.innerHTML = `
            <div class="card-body p-4" style="background: #fff3cd; border-left: 4px solid #ff9800;">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-clipboard-pulse me-2"></i>Recommended Next Steps
                </h5>
                <ol class="mb-3">
                    <li class="mb-2"><strong>Consult a Neurologist:</strong> Schedule an appointment with a qualified neurologist immediately for professional evaluation.</li>
                    <li class="mb-2"><strong>Additional Tests:</strong> Your doctor may recommend further diagnostic tests such as contrast MRI, CT scan, or biopsy.</li>
                    <li class="mb-2"><strong>Bring This Report:</strong> Download and bring this analysis report to your doctor's appointment.</li>
                    <li class="mb-0"><strong>Don't Panic:</strong> Early detection improves treatment outcomes. Follow your doctor's guidance.</li>
                </ol>
                <h6 class="fw-bold mt-3 mb-2">All Probabilities:</h6>
                <ul class="mb-0">
                    ${Object.entries(probabilities).map(([className, prob]) => 
                        `<li><strong>${classDisplayNames[className] || className}:</strong> ${prob.toFixed(2)}%</li>`
                    ).join('')}
                </ul>
            </div>
        `;
    } else {
        // No tumor detected result
        resultCard.innerHTML = `
            <div class="card-body p-4" style="background: linear-gradient(135deg, #FAFAF7 0%, #8A6E45 100%); 
box-shadow: 0 8px 24px rgba(138, 110, 69, 0.2), 0 0 30px rgba(138, 110, 69, 0.1); 
border: 1px solid rgba(138, 110, 69, 0.3);">
                <div class="text-white text-center">
                    <i class="bi bi-check-circle-fill result-clear-animation" style="font-size: 4rem; opacity: 0.9;"></i>
                    <h2 class="fw-bold mt-3 mb-2 animate-fadeInUp" style="animation-delay: 0.5s;">No Tumor Detected</h2>
                    <p class="mb-0 fs-5 animate-fadeInUp" style="animation-delay: 0.7s;">Our AI system did not identify any tumor in your scan</p>
                    <p class="mb-0 mt-2 opacity-75 animate-fadeInUp" style="animation-delay: 0.9s;">Model Confidence: ${confidence}%</p>
                </div>
            </div>
        `;

        recommendationBox.innerHTML = `
            <div class="card-body p-4" style="background: #d1f2eb; border-left: 4px solid #4caf50;">
                <h5 class="fw-bold mb-3">
                    <i class="bi bi-clipboard-check me-2"></i>Recommended Next Steps
                </h5>
                <ol class="mb-3">
                    <li class="mb-2"><strong>Routine Follow-up:</strong> Schedule a routine follow-up with your doctor to discuss the results.</li>
                    <li class="mb-2"><strong>Maintain Records:</strong> Keep this report for your medical records.</li>
                    <li class="mb-2"><strong>Regular Screening:</strong> Continue with regular health check-ups as recommended by your doctor.</li>
                    <li class="mb-0"><strong>Healthy Lifestyle:</strong> Maintain a healthy lifestyle and report any new symptoms to your doctor.</li>
                </ol>
                <h6 class="fw-bold mt-3 mb-2">All Probabilities:</h6>
                <ul class="mb-0">
                    ${Object.entries(probabilities).map(([className, prob]) => 
                        `<li><strong>${classDisplayNames[className] || className}:</strong> ${prob.toFixed(2)}%</li>`
                    ).join('')}
                </ul>
            </div>
        `;
    }
}

function downloadReport() {
    showAlert('Report download feature - demo only. In production, this would generate a detailed PDF report.', 'info');
}
