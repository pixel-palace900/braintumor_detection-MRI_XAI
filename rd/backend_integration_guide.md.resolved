### 3. Update [doctor-review.html](file:///c:/Users/PMLS/Desktop/ui%20ph1/doctor-review.html)

**Location:** Lines 303-343 (inside the [loadScanDetails](file:///c:/Users/PMLS/Desktop/ui%20ph1/doctor-review.html#303-344) function)

**Replace the [loadScanDetails](file:///c:/Users/PMLS/Desktop/ui%20ph1/doctor-review.html#303-344) function** (lines 304-343) with:

```javascript
// Function to load and populate all data
function loadScanDetails(scanId) {
    // Load REAL prediction data from sessionStorage
    const predictedClass = sessionStorage.getItem('predictedClass');
    const confidence = sessionStorage.getItem('confidence');
    const probabilities = sessionStorage.getItem('probabilities');
    const uploadedImage = sessionStorage.getItem('uploadedImage');
    
    // Also load doctor scan data if available
    const doctorScans = JSON.parse(sessionStorage.getItem('doctorScans') || '[]');
    const scanData = doctorScans.length > 0 ? doctorScans[doctorScans.length - 1] : null;

    // Populate Patient Information
    if (scanData) {
        document.querySelectorAll('.card-body p.fw-bold')[0].textContent = scanData.patientName || 'Ahmad Khan';
        document.querySelectorAll('.card-body p.fw-bold')[1].textContent = scanData.patientId || 'PT-2025-456';
        document.querySelectorAll('.card-body p.fw-bold')[2].textContent = scanData.age ? `${scanData.age} years` : '45 years';
        
        const uploadDate = scanData.uploadDate ? new Date(scanData.uploadDate) : new Date();
        const dateOptions = { year: 'numeric', month: 'long', day: 'numeric' };
        document.querySelectorAll('.card-body p.fw-bold')[3].textContent = uploadDate.toLocaleDateString('en-US', dateOptions);
    }

    // Populate the uploaded scan image - REAL IMAGE
    if (uploadedImage) {
        document.getElementById('originalMRI').src = uploadedImage;
    } else if (scanData && scanData.scanImage) {
        document.getElementById('originalMRI').src = scanData.scanImage;
    } else {
        console.warn('No scan image found in sessionStorage');
        document.getElementById('originalMRI').src = 'images/heatmap-sample.jpg'; // Fallback
    }

    // Update Analysis Date/Time
    const now = new Date();
    const dateTimeOptions = { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' };
    document.getElementById('analysisDateTime').textContent = now.toLocaleDateString('en-US', dateTimeOptions);

    // Display REAL prediction results
    if (predictedClass && confidence) {
        // Map class names to display names
        const classDisplayNames = {
            'glioma': 'Glioma Tumor',
            'meningioma': 'Meningioma Tumor',
            'pituitary': 'Pituitary Tumor',
            'notumor': 'No Tumor'
        };
        
        const displayName = classDisplayNames[predictedClass] || predictedClass;
        const tumorDetected = predictedClass !== 'notumor';
        
        // Update the classification result card
        const classificationCard = document.querySelector('.text-center.mb-4.p-4');
        if (classificationCard) {
            if (tumorDetected) {
                classificationCard.style.background = 'linear-gradient(135deg, #ff9800 0%, #ff6f00 100%)';
                classificationCard.innerHTML = `
                    <i class="bi bi-exclamation-triangle-fill text-white" style="font-size: 3rem;"></i>
                    <h3 class="text-white fw-bold mt-2 mb-0">Tumor Detected: ${displayName}</h3>
                `;
            } else {
                classificationCard.style.background = 'linear-gradient(135deg, #4caf50 0%, #2e7d32 100%)';
                classificationCard.innerHTML = `
                    <i class="bi bi-check-circle-fill text-white" style="font-size: 3rem;"></i>
                    <h3 class="text-white fw-bold mt-2 mb-0">No Tumor Detected</h3>
                `;
            }
        }
        
        // Update confidence display
        const confidenceElement = document.querySelector('.col-md-6 .p-3.bg-light.rounded h4');
        if (confidenceElement) {
            confidenceElement.textContent = confidence + '%';
        }
        
        // Update probabilities table if available
        if (probabilities) {
            try {
                const probs = JSON.parse(probabilities);
                const tableBody = document.querySelector('.table tbody');
                if (tableBody) {
                    tableBody.innerHTML = `
                        <tr>
                            <td class="fw-semibold">Glioma</td>
                            <td class="text-end"><span class="badge bg-primary">${probs.glioma ? probs.glioma.toFixed(2) : '0.00'}%</span></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">Meningioma</td>
                            <td class="text-end"><span class="badge bg-info">${probs.meningioma ? probs.meningioma.toFixed(2) : '0.00'}%</span></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">Pituitary</td>
                            <td class="text-end"><span class="badge bg-warning">${probs.pituitary ? probs.pituitary.toFixed(2) : '0.00'}%</span></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold">No Tumor</td>
                            <td class="text-end"><span class="badge bg-success">${probs.notumor ? probs.notumor.toFixed(2) : '0.00'}%</span></td>
                        </tr>
                    `;
                }
            } catch (e) {
                console.error('Error parsing probabilities:', e);
            }
        }
    } else {
        console.warn('No prediction data found in sessionStorage, using default values');
    }
}
```

